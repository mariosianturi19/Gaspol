# Copy to .env and fill in. .env is gitignored; never commit real values.

# MySQL connection string used by Prisma.
DATABASE_URL="mysql://user:password@host:3306/database"

# Signs and verifies session cookies. The app refuses to start without it.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=""

# Accounts created by `npx prisma db seed`. Only needed when seeding.
SEED_PROSESOR_EMAIL="admin@example.com"
SEED_PROSESOR_PASSWORD=""
SEED_SALES_EMAIL="sales@example.com"
SEED_SALES_PASSWORD=""
